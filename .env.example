# =====================================================================
# Analytics Copilot - settings template
# Copy this file to ".env" and fill in your own keys.
# NEVER commit ".env" or share it. This example file has no real keys.
# =====================================================================

# ---------------------------------------------------------------------
# 1. MODELS  (main model first, then backups, in the order to try)
# Format:  provider:model_name , provider:model_name , ...
# Providers available: gemini, groq, openai, openrouter
# If the first model hits a rate limit, the app tries the next one.
# ---------------------------------------------------------------------
LLM_MODELS=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b

# ---------------------------------------------------------------------
# 2. API KEYS  (fill only the providers you use in LLM_MODELS)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------
# 3. ENDPOINTS  (OpenAI-compatible base URLs, change only if a provider
#    changes its address; verify against the provider's docs)
# ---------------------------------------------------------------------
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------
# 4. BEHAVIOUR  (all optional; these are the defaults)
# ---------------------------------------------------------------------
# Lower = more consistent answers
LLM_TEMPERATURE=0.2
# Maximum length of each model reply. Thinking models use part of this for
# reasoning, so keep it generous. If replies get cut off, raise it.
LLM_MAX_TOKENS=4000
# Sample rows per sheet sent to the model (the model never gets full data)
SAMPLE_ROWS=5
# Seconds allowed for the model's code to run before it is stopped
CODE_TIMEOUT_SECONDS=30
# How many times to ask the model to fix its own code after an error
CODE_FIX_RETRIES=1
