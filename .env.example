# Analytics Copilot settings
# Copy this file to .env and add your key. Never share or commit .env.
# Get a free key at https://aistudio.google.com (sidebar: "Get API key")

GEMINI_API_KEY=

# Main model first, then backups
LLM_MODELS=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite

# Optional (defaults shown)
# Max length of each model reply, in tokens. Raise it if answers get cut off.
# LLM_MAX_TOKENS=4000
# Rows per sheet shown to the model. Lower = less data sent. 0 = columns only.
# SAMPLE_ROWS=5
# Langfuse: records every AI call (model, tokens, cost, latency) for the LLM Insights page.
# Leave the keys empty to switch it off. The app still works without it.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com